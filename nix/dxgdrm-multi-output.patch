+static int dxgdrm_bind_output_ioctl(struct drm_device *dev, void *data,
+				    struct drm_file *file)
+{
+	struct drm_dxgdrm_bind_output *args = data;
+	struct dxgdrm_file *priv = file->driver_priv;
+	int ret = 0;
+
+	if (args->pad || args->index >= DXGDRM_MAX_OUTPUTS)
+		return -EINVAL;
+	mutex_lock(&priv->bind_lock);
+	if (test_bit(0, &priv->presenter))
+		ret = -EBUSY;
+	else
+		WRITE_ONCE(priv->output_index, args->index);
+	mutex_unlock(&priv->bind_lock);
+	return ret;
+}

+static int dxgdrm_set_outputs_ioctl(struct drm_device *dev, void *data,
+				    struct drm_file *file)
+{
+	struct drm_dxgdrm_set_outputs *args = data;
+	struct dxgdrm_device *device = to_dxgdrm(dev);
+	unsigned int i;
+	bool changed = false;
+
+	if (args->pad || args->count > DXGDRM_MAX_OUTPUTS)
+		return -EINVAL;
+	for (i = 0; i < args->count; i++) {
+		struct drm_dxgdrm_output_mode *mode = &args->modes[i];
+
+		if (mode->pad || mode->width < 64 ||
+		    mode->width > DXGDRM_MAX_DIMENSION || mode->height < 64 ||
+		    mode->height > DXGDRM_MAX_DIMENSION ||
+		    (mode->refresh_mhz && (mode->refresh_mhz < 1000 ||
+					   mode->refresh_mhz > DXGDRM_MAX_REFRESH_MHZ)))
+			return -EINVAL;
+	}
+
+	mutex_lock(&device->outputs_lock);
+	for (i = 0; i < DXGDRM_MAX_OUTPUTS; i++) {
+		struct dxgdrm_output *output = &device->outputs[i];
+		bool connected = i < args->count;
+
+		if (output->connected != connected) {
+			output->connected = connected;
+			changed = true;
+		}
+		if (connected) {
+			struct drm_dxgdrm_output_mode *mode = &args->modes[i];
+			unsigned int mhz = mode->refresh_mhz ?: dxgdrm_default_refresh_mhz();
+
+			if (output->mode_width != mode->width ||
+			    output->mode_height != mode->height ||
+			    output->mode_refresh_mhz != mhz)
+				changed = true;
+			output->mode_width = mode->width;
+			output->mode_height = mode->height;
+			output->mode_refresh_mhz = mhz;
+		}
+	}
+	mutex_unlock(&device->outputs_lock);

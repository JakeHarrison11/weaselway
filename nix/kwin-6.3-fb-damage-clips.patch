 }
 
 const ColorPipeline &DrmPipelineLayer::colorPipeline() const
 {
     return m_colorPipeline;
 }
+
+bool DrmPipelineLayer::tracksFrameDamage() const
+{
+    return false;
+}
+
+uint64_t DrmPipelineLayer::frameSerial() const
+{
+    return m_frameSerial;
+}
+
+std::optional<QRegion> DrmPipelineLayer::bufferDamage(const DrmPlane *plane)
+{
+    const auto presented = std::find_if(m_frameDamage.begin(), m_frameDamage.end(), [plane](const FrameDamage &frame) {
+        return frame.serial == plane->presentedFrameSerial();
+    });
+    if (presented == m_frameDamage.end()) {
+        return std::nullopt;
+    }
+    m_frameDamage.erase(m_frameDamage.begin(), presented);
+    QRegion damage;
+    for (auto frame = std::next(m_frameDamage.begin()); frame != m_frameDamage.end(); ++frame) {
+        if (!frame->damage) {
+            return std::nullopt;
+        }
+        damage |= *frame->damage;
+    }
+    return damage;
+}
+
+void DrmPipelineLayer::addFrameDamage(const std::optional<QRegion> &damage)
+{
+    // Globally unique serials prevent a different layer using this plane from
+    // being mistaken for a previously presented frame of this layer.
+    static std::atomic<uint64_t> nextSerial{1};
+    m_frameSerial = nextSerial++;
+    if (m_frameDamage.size() >= 16) {
+        m_frameDamage.clear();
+        m_frameDamage.push_back(FrameDamage{m_frameSerial, std::nullopt});
+    } else {
+        m_frameDamage.push_back(FrameDamage{m_frameSerial, damage});
+    }
+}
 }

 bool EglGbmLayer::doEndFrame(const QRegion &renderedRegion, const QRegion &damagedRegion, OutputFrame *frame)
 {
-    return m_surface.endRendering(damagedRegion, frame);
+    if (!m_surface.endRendering(damagedRegion, frame)) {
+        addFrameDamage(std::nullopt);
+        return false;
+    }
+    if (m_pipeline->output()->transform() == OutputTransform::Kind::Normal) {
+        QRegion deviceDamage;
+        const qreal scale = m_pipeline->output()->scale();
+        const QRegion clipped = damagedRegion & m_pipeline->output()->rectF().toAlignedRect();
+        for (const QRect &rect : clipped) {
+            deviceDamage |= QRectF(rect.x() * scale, rect.y() * scale, rect.width() * scale, rect.height() * scale).toAlignedRect();
+        }
+        addFrameDamage(deviceDamage);
+    } else {
+        addFrameDamage(std::nullopt);
+    }
+    return true;
 }
 
 bool EglGbmLayer::checkTestBuffer()

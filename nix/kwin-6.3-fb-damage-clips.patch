From: weaselway
Subject: [PATCH] backends/drm: report damage to the kernel with FB_DAMAGE_CLIPS

Backport the KWin 6.6 damage tracking to 6.3. Damage is accumulated until
the plane presents a frame; direct scanout, buffer changes, unknown history
and rotated outputs fall back to full damage. KWin 6.3 provides logical
damage, so convert it to buffer pixels before reporting it.

---
diff --git a/src/backends/drm/drm_commit.cpp b/src/backends/drm/drm_commit.cpp
index 6b201f9..b7e15b0 100644
--- a/src/backends/drm/drm_commit.cpp
+++ b/src/backends/drm/drm_commit.cpp
@@ -44,6 +44,8 @@ void DrmCommit::setDefunct()
     m_defunct = true;
 }
 
+static const qsizetype s_maxDamageClips = 64;
+
 DrmAtomicCommit::DrmAtomicCommit(DrmGpu *gpu)
     : DrmCommit(gpu)
 {
@@ -76,6 +78,10 @@ void DrmAtomicCommit::addBuffer(DrmPlane *plane, const std::shared_ptr<DrmFrameb
     addProperty(plane->fbId, buffer ? buffer->framebufferId() : 0);
     m_buffers[plane] = buffer;
     m_frames[plane] = frame;
+    m_frameSerials[plane] = 0;
+    if (plane->fbDamage.isValid()) {
+        addBlob(plane->fbDamage, nullptr);
+    }
     // atomic commits with IN_FENCE_FD fail with NVidia and (as of kernel 6.9) with tearing
     if (plane->inFenceFd.isValid() && !plane->gpu()->isNVidia() && !isTearing()) {
         addProperty(plane->inFenceFd, buffer ? buffer->syncFd().get() : -1);
@@ -90,6 +96,38 @@ void DrmAtomicCommit::addBuffer(DrmPlane *plane, const std::shared_ptr<DrmFrameb
     }
 }
 
+void DrmAtomicCommit::addDamage(DrmPlane *plane, const std::optional<QRegion> &damage, uint64_t frameSerial)
+{
+    m_frameSerials[plane] = frameSerial;
+    const auto buffer = m_buffers[plane];
+    if (!damage || !buffer || !buffer->buffer()) {
+        // no clips means that everything is damaged
+        addBlob(plane->fbDamage, nullptr);
+        return;
+    }
+    const QRegion clipped = *damage & QRect(QPoint(), buffer->buffer()->size());
+    std::vector<drm_mode_rect> clips;
+    const auto addClip = [&clips](const QRect &rect) {
+        clips.push_back(drm_mode_rect{
+            .x1 = rect.left(),
+            .y1 = rect.top(),
+            .x2 = rect.left() + rect.width(),
+            .y2 = rect.top() + rect.height(),
+        });
+    };
+    if (clipped.isEmpty()) {
+        // there's no way to say "nothing"; one pixel is the closest to it
+        addClip(QRect(0, 0, 1, 1));
+    } else if (clipped.rectCount() > s_maxDamageClips) {
+        addClip(clipped.boundingRect());
+    } else {
+        for (const QRect &rect : clipped) {
+            addClip(rect);
+        }
+    }
+    addBlob(plane->fbDamage, DrmBlob::create(m_gpu, clips.data(), clips.size() * sizeof(drm_mode_rect)));
+}
+
 void DrmAtomicCommit::setVrr(DrmCrtc *crtc, bool vrr)
 {
     addProperty(crtc->vrrEnabled, vrr ? 1 : 0);
@@ -171,6 +209,9 @@ void DrmAtomicCommit::pageFlipped(std::chrono::nanoseconds timestamp)
     for (const auto &[plane, buffer] : m_buffers) {
         plane->setCurrentBuffer(buffer);
     }
+    for (const auto &[plane, serial] : m_frameSerials) {
+        plane->setPresentedFrameSerial(serial);
+    }
     if (m_defunct) {
         return;
     }
@@ -228,6 +269,11 @@ void DrmAtomicCommit::merge(DrmAtomicCommit *onTop)
     for (const auto &[prop, blob] : onTop->m_blobs) {
         m_blobs[prop] = blob;
     }
+    // the damage of a later frame includes that of the earlier ones that
+    // weren't presented yet, so there's nothing to add up here
+    for (const auto &[plane, serial] : onTop->m_frameSerials) {
+        m_frameSerials[plane] = serial;
+    }
     if (onTop->m_vrr) {
         m_vrr = onTop->m_vrr;
     }
